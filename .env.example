# Dalil · Cloudflare D1
# Copiar a .env.local únicamente para desarrollo/validación local.
# .env.local está ignorado por Git. No versionar valores reales.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# GitHub · opcional para desarrollo local
# Amplía el rate limit de consultas a repositorios públicos.
# No es requerido para el workflow, que usa github.token.

GITHUB_TOKEN=
