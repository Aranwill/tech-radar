{
  "name": "tech-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Radar de inteligencia tecnológica con fuentes trazables y UI estructurada.",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "11.28.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "schema:validate": "node scripts/validate-d1-schema.mjs",
    "security:baseline": "node scripts/security-baseline.mjs",
    "snapshot:github": "node scripts/github-snapshot.mjs",
    "snapshot:validate": "node scripts/validate-github-snapshot-pipeline.mjs",
    "history:validate": "node scripts/validate-github-history.mjs",
    "d1:verify": "node scripts/verify-d1-remote.mjs",
    "d1:verify:syntax": "node --check scripts/verify-d1-remote.mjs",
    "d1:config:validate": "node scripts/validate-d1-runtime-config.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
